need_root() {
  if [ "$(id -u)" -ne 0 ]; then
    have sudo || die "must run as root (sudo not found)"
    exec sudo -- "$0" "$@"
  fi
}

# Console (logged-in GUI) user, for loading the per-user tray agent from a root ctx.
console_user() { stat -f %Su /dev/console 2>/dev/null; }
console_uid()  { id -u "$(console_user)" 2>/dev/null; }

# Stop every tray agent belonging to $1 (a uid) and wait for it to actually exit.
# Not all of them are launchd's: the GUI spawns one too, so `launchctl bootout` alone
# would leave strays running the *old* bundle. They also hold the agent's flock, and a
# freshly kickstarted agent exits on losing that race — so wait for the fd to close
# rather than just signalling. The " --agent" in the pattern keeps the GUI process out.
gui_agent_kill() {
  local u="$1" i=0
  pkill -u "$u" -f 'MacOS/nullgate --agent' >/dev/null 2>&1 || true
  while pgrep -u "$u" -f 'MacOS/nullgate --agent' >/dev/null 2>&1; do
    i=$((i + 1))
    [ "$i" -gt 30 ] && { pkill -9 -u "$u" -f 'MacOS/nullgate --agent' >/dev/null 2>&1 || true; break; }
    sleep 0.1
  done
}

# (Re)start the per-user tray agent in the console user's Aqua session, so the tray
# appears now on a fresh install and picks up the new binary on an upgrade — without
# waiting for the next login.
#
# `bootstrap` is a *no-op on an already-loaded job*, so it alone never picks up a
# changed plist: machines that loaded the pre-a10dbed job kept launching the GUI
# (`--minimized`) instead of the tray agent, indefinitely. Worse, the loaded job
# still pointed at the replaced bundle's binary, so launchd's spawns died with
# OS_REASON_CODESIGNING. Always `bootout` first, then load the plist from disk.
gui_agent_reload() {
  local u; u="$(console_uid)"
  [ -n "$u" ] || { log "no console user; the tray starts at next login"; return 0; }
  launchctl bootout "gui/$u/$APP_ID.gui" >/dev/null 2>&1 || true
  gui_agent_kill "$u"
  # RunAtLoad starts it; kickstart only as a fallback if it was already loaded.
  launchctl bootstrap "gui/$u" "$AGENTS/$APP_ID.gui.plist" >/dev/null 2>&1 \
    || launchctl kickstart "gui/$u/$APP_ID.gui" >/dev/null 2>&1 || true
  local i=0
  while [ "$i" -lt 30 ]; do
    if pgrep -u "$u" -f 'MacOS/nullgate --agent' >/dev/null 2>&1; then
      log "tray agent started for uid $u"
      return 0
    fi
    i=$((i + 1)); sleep 0.1
  done
  log "WARNING: the tray agent did not start; it will start at next login"
}

version_gt() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1)" = "$2" ]; }
installed_version() { have nullgate-daemon && nullgate-daemon --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1; }

latest_version() {
  have curl || die "curl is required"
  curl -fsSL "https://api.github.com/repos/$REPO/releases/latest" 2>/dev/null \
    | grep -m1 '"tag_name"' | sed -E 's/.*"tag_name": *"v?([^"]+)".*/\1/'
}

fetch_latest_tree() {
  have curl || die "curl is required"
  local json url root
  json="$(curl -fsSL "https://api.github.com/repos/$REPO/releases/latest")" || die "cannot reach $REPO releases API"
  url="$(printf '%s' "$json" | grep -oE "\"browser_download_url\": *\"$ASSET_RE\"" | sed -E 's/.*"(https[^"]+)".*/\1/' | head -n1)"
  [ -n "$url" ] || die "latest release has no macos-$HOST (or -universal) tarball"
  WORKDIR="$(mktemp -d)"
  curl -fsSL -o "$WORKDIR/pkg.tgz" "$url" || die "download failed"
  tar -xzf "$WORKDIR/pkg.tgz" -C "$WORKDIR" || die "extract failed"
  root="$(find "$WORKDIR" -maxdepth 2 -type d -name "$APP_NAME" -exec dirname {} \; | head -n1)"
  [ -n "$root" ] || die "archive missing $APP_NAME"
  printf '%s\n' "$root"
}

daemon_bootout() { launchctl bootout "system/$APP_ID.daemon" >/dev/null 2>&1 || true; }
update_bootout() { launchctl bootout "system/$APP_ID.update" >/dev/null 2>&1 || true; }
gui_bootout()    { local u; u="$(console_uid)"; [ -n "$u" ] && launchctl bootout "gui/$u/$APP_ID.gui" >/dev/null 2>&1 || true; }

# The Team ID in a bundle's signature, or "adhoc" for an ad-hoc seal, or "" if
# it is not signed at all.
team_of() {
  local out; out="$(codesign -dv --verbose=2 "$1" 2>&1)" || { printf ''; return; }
  if printf '%s' "$out" | grep -q '^Signature=adhoc'; then printf 'adhoc'; return; fi
  printf '%s' "$out" | sed -n 's/^TeamIdentifier=//p' | head -n1
}
# Refuse to install a bundle that is broken or signed by someone else. The
# release bundles are Developer-ID signed and notarized; an installed copy
# signed by team X must only ever be replaced by one signed by team X. A
# machine that installed an older ad-hoc build accepts either (there is
# nothing to compare against) — which is how it migrates to the signed builds.
verify_bundle() {
  local new="$1" new_team old_team
  codesign --verify --deep --strict "$new" 2>/dev/null || die "refusing $APP_NAME: its code signature does not verify"
  new_team="$(team_of "$new")"
  old_team=""; [ -d "$APP_DST" ] && old_team="$(team_of "$APP_DST")"
  case "$old_team" in
    ""|adhoc) ;;   # nothing trustworthy to compare against
    *) [ "$new_team" = "$old_team" ] || die "refusing $APP_NAME: signed by team '${new_team:-none}', the installed app is by '$old_team'" ;;
  esac
  log "signature OK (team: ${new_team:-none})"
}
apply_tree() {
  local src="$1"
  [ -d "$src/$APP_NAME" ] || die "release tree '$src' has no $APP_NAME"
  verify_bundle "$src/$APP_NAME"

  log "stopping services"
  daemon_bootout
  mkdir -p "$LOG_DIR" "$BIN_DIR"

  # Replace the app (staged as .new, then swapped). ditto (not cp -R) preserves the
  # bundle's xattrs/signature metadata intact, the way Finder's copy does.
  rm -rf "$APP_DST.new"
  ditto "$src/$APP_NAME" "$APP_DST.new"
  rm -rf "$APP_DST"
  mv "$APP_DST.new" "$APP_DST"

  # Tell macOS the app exists. A plain sudo copy into /Applications never triggers
  # the Launch Services registration + Spotlight import that a Finder drag would, so
  # the app runs but never appears in Spotlight / Open With. Re-run on every update
  # too: replacing the bundle can stale out the existing Launch Services record.
  local lsregister="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
  [ -x "$lsregister" ] && "$lsregister" -f "$APP_DST" >/dev/null 2>&1 || true
  command -v mdimport >/dev/null 2>&1 && mdimport "$APP_DST" >/dev/null 2>&1 || true

  local b
  for b in nullgate nullgate-daemon nullgate-cli; do
    ln -sfn "$MACOS/$b" "$BIN_DIR/$b"
  done
  # nullgatectl is a real file (atomic swap), not a symlink into the app.
  install -m 0755 "$src/nullgatectl" "$BIN_DIR/nullgatectl.t$$"
  mv -f "$BIN_DIR/nullgatectl.t$$" "$BIN_DIR/nullgatectl"

  [ -f "$src/LaunchDaemons/$APP_ID.daemon.plist" ] && install -m 0644 "$src/LaunchDaemons/$APP_ID.daemon.plist" "$DAEMONS/$APP_ID.daemon.plist"
  [ -f "$src/LaunchDaemons/$APP_ID.update.plist" ] && install -m 0644 "$src/LaunchDaemons/$APP_ID.update.plist" "$DAEMONS/$APP_ID.update.plist"
  [ -f "$src/LaunchAgents/$APP_ID.gui.plist" ]     && install -m 0644 "$src/LaunchAgents/$APP_ID.gui.plist"     "$AGENTS/$APP_ID.gui.plist"
}

cmd_install() {
  need_root "--install" "$@"
  banner
  local auto=1 gui=1 a
  for a in "$@"; do case "$a" in
    --no-auto-update) auto=0 ;;
    --no-gui-autostart) gui=0 ;;
    *) die "unknown flag for --install: $a" ;;
  esac; done

  local here tree
  here="$(cd "$(dirname "$0")" && pwd)"
  if [ -d "$here/$APP_NAME" ]; then tree="$here"; else log "no local release tree; fetching latest"; tree="$(fetch_latest_tree)"; fi

  log "installing $APP_NAME to /Applications"
  apply_tree "$tree"

  launchctl bootstrap system "$DAEMONS/$APP_ID.daemon.plist" >/dev/null 2>&1 \
    && log "daemon started (root LaunchDaemon)" || log "WARNING: could not load the daemon"
  if [ "$auto" = 1 ]; then
    launchctl bootstrap system "$DAEMONS/$APP_ID.update.plist" >/dev/null 2>&1 \
      && log "daily auto-update enabled" || true
  fi
  if [ "$gui" = 1 ]; then
    gui_agent_reload
  fi
  log "done. Open \"Nullgate\" from /Applications."
}

cmd_update() {
  local check=0 a
  for a in "$@"; do case "$a" in --check) check=1 ;; *) die "unknown flag for --update: $a" ;; esac; done

  local inst latest
  inst="$(installed_version || true)"
  [ -n "$inst" ] || die "not installed; run: nullgatectl --install"
  latest="$(latest_version)"
  [ -n "$latest" ] || die "could not determine the latest release"
  log "installed $inst, latest $latest"
  if ! version_gt "$inst" "$latest"; then log "up to date"; return 0; fi
  log "update available: $inst -> $latest"
  [ "$check" = 1 ] && return 0
  need_root "--update"
  banner
  local tree; tree="$(fetch_latest_tree)"
  apply_tree "$tree"
  launchctl bootstrap system "$DAEMONS/$APP_ID.daemon.plist" >/dev/null 2>&1 || true
  # Restart the tray agent onto the new binary if the LaunchAgent is installed.
  [ -f "$AGENTS/$APP_ID.gui.plist" ] && gui_agent_reload
  log "updated to $latest"
}

cmd_uninstall() {
  need_root "--uninstall" "$@"
  banner
  local purge=0 a
  for a in "$@"; do case "$a" in --purge) purge=1 ;; *) die "unknown flag for --uninstall: $a" ;; esac; done

  gui_bootout
  update_bootout
  daemon_bootout
  rm -f "$DAEMONS/$APP_ID.daemon.plist" "$DAEMONS/$APP_ID.update.plist" "$AGENTS/$APP_ID.gui.plist"
  local b
  for b in nullgate nullgate-daemon nullgate-cli nullgatectl; do rm -f "$BIN_DIR/$b"; done
  rm -rf "$APP_DST" "$LOG_DIR"
  log "removed the app, launch daemons/agent, and symlinks."
  if [ "$purge" = 1 ]; then
    rm -rf "$HOME/Library/Application Support/$APP_ID"
    log "purged data (any secrets in the Keychain are left intact)."
  fi
}

cmd_status() {
  printf '%-13s %s\n' "installed:" "$(installed_version || echo none)"
  printf '%-13s %s\n' "latest:"    "$(latest_version 2>/dev/null || echo '?')"
  printf '%-13s %s\n' "daemon:"    "$(launchctl print "system/$APP_ID.daemon" >/dev/null 2>&1 && echo loaded || echo stopped)"
  printf '%-13s %s\n' "auto-update:" "$(launchctl print "system/$APP_ID.update" >/dev/null 2>&1 && echo enabled || echo disabled)"
  printf '%-13s %s\n' "app:"       "$([ -d "$APP_DST" ] && echo "$APP_DST" || echo "not installed")"
}

usage() {
  banner
  cat <<'EOF'
Nullgate installer/updater - macOS

  nullgatectl --install [--no-auto-update] [--no-gui-autostart]
  nullgatectl --update  [--check]
  nullgatectl --uninstall [--purge]
  nullgatectl --status

The daemon installs as a root LaunchDaemon (needs root for the utun interface);
the GUI runs per-user. install/update/uninstall use sudo.
EOF
}

case "${1:-}" in
  --install)   shift; cmd_install "$@" ;;
  --update)    shift; cmd_update "$@" ;;
  --uninstall) shift; cmd_uninstall "$@" ;;
  --status)    shift; cmd_status ;;
  --check)     cmd_update --check ;;
  -h|--help|"") usage ;;
  *)           die "unknown command: $1 (try --help)" ;;
esac
